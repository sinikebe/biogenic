# Biogenic's dedicated server: the shared pond, on the home LAN -- and, for
# friends outside the house, by invite on a second port (docs/server.md §9).
#
# Installed to /etc/systemd/system/ by install-server.sh, from the same release
# as the build it runs. See docs/server.md.
#
# The build updates itself (every ten minutes, never with anyone connected), so
# /opt/biogenic belongs to the service user: a new build is written next to the
# running one and renamed over it. An update ends with the process exiting on
# its own, and Restart=always is what starts the new build.

[Unit]
Description=Biogenic dedicated server (shared pond: the LAN, and friends by invite)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=biogenic
Group=biogenic
# Godot keeps user:// -- the staged content packs, the update state, its own
# logs -- under $HOME/.local/share/godot/app_userdata/Biogenic. StateDirectory
# makes /var/lib/biogenic, owned by the user, and keeps it across restarts,
# reboots and reinstalls.
StateDirectory=biogenic
WorkingDirectory=/var/lib/biogenic
Environment=HOME=/var/lib/biogenic
# /run/biogenic, for the stop file below; systemd empties it at every stop.
RuntimeDirectory=biogenic
ExecStart=/opt/biogenic/biogenic-server.x86_64 --headless -- --stop-file=/run/biogenic/stop
# Godot does not catch SIGTERM: killed, the guests would only notice when their
# connections time out. So a stop asks first -- the server polls for this file,
# tells its guests, and exits 0 -- and SIGTERM stays the backstop. $MAINPID is
# unset when the process has already gone (an update's restart), and then
# there is nothing to ask.
ExecStop=/bin/sh -c 'if [ -n "$$MAINPID" ]; then touch /run/biogenic/stop; timeout 10 tail --pid="$$MAINPID" -s 0.2 -f /dev/null; fi; exit 0'
Restart=always
RestartSec=5
TimeoutStopSec=20

# --- Least privilege for the network-facing process (issue #70). These are
# seccomp-, capability- and rlimit-based controls that need no mount namespace,
# so they hold in the unprivileged Proxmox LXC of docs/server.md §1 whether or
# not it has nesting. Measured on the exported build: it opens both ports,
# answers a DTLS handshake and runs the invite jobs under all of them. The
# stronger mount-namespace directives -- ProtectSystem=strict and the rest --
# need `--features nesting=1` and a boot test on your own container, so they are
# an opt-in drop-in in §9.10, not shipped here where they would silently fail a
# container that follows §1.
NoNewPrivileges=yes
# The service binds 45771 and 45772 (both above 1024) as an unprivileged user
# and needs no capability at all; an empty bounding set means a hole in the
# process cannot pick one up either.
CapabilityBoundingSet=
AmbientCapabilities=
# getifaddrs() -- how the server finds the address it logs -- speaks over
# AF_NETLINK, so that stays; without it the server finds no address and listens
# on nothing. AF_PACKET and the rest are never opened.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# An exported Godot server runs no JIT, so it never needs a page both writable
# and executable; refusing that shuts the usual door from a memory bug to code.
MemoryDenyWriteExecute=yes
ProtectClock=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
