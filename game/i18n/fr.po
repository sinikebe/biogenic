#: game/normal/programs_page.gd
msgid "not yet"
msgstr "pas encore"

#. The title of the sheet that renames one of the player's programs (lists of
#. the cell's "instincts"), in 22 px type.
#. Room: at most 512 px in 22 px type; the English takes 226 px.
#: game/normal/programs_page.gd
msgid "rename this program"
msgstr "renommer ce programme"

#. Under "delete <name>?" for a program with no instincts: nothing is lost. A
#. full sentence.
#: game/normal/programs_page.gd
msgid "it holds no instincts: nothing is lost."
msgstr "il ne contient aucun instinct : rien n'est perdu."

#. How many "instincts" (rules) a program holds, on its row in 14 px type: "1
#. instinct", "7 instincts". Lowercase.
#. Room: at most 90 px in 14 px type, measured with 7 in place of the
#. placeholders; the English takes 63 px.
#: game/normal/programs_page.gd
#, c-format
msgid "%d instinct"
msgid_plural "%d instincts"
msgstr[0] "%d instinct"
msgstr[1] "%d instincts"

#. Under "delete <name>?", in 17 px type, wrapping: the program's instincts
#. are deleted with it; %d is how many. A full sentence.
#: game/normal/programs_page.gd
#, c-format
msgid "its %d instinct is gone for good."
msgid_plural "its %d instincts are gone for good."
msgstr[0] "son %d instinct disparaît pour de bon."
msgstr[1] "ses %d instincts disparaissent pour de bon."
